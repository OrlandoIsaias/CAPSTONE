DATABASE_URL=postgresql://usuario:password@host/nombre_bd?sslmode=require

# Debe ser exactamente el mismo JWT_SECRET de auth-service (obligatorio)
JWT_SECRET=tu-clave-secreta-larga-y-aleatoria-de-64-caracteres

# Cloudinary (las mismas de mascotas-service): fotos, audios y videos del chat
# de seguimiento. Sin ellas el chat funciona solo con texto.
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# Solo para pruebas: true permite responder las encuestas de 30 y 90 días
# apenas se confirma la adopción. Nunca activarlo en producción.
SEGUIMIENTO_SIN_ESPERA=false
