DATABASE_URL=postgresql://usuario:password@host/nombre_bd?sslmode=require

# Clave secreta para firma y validación de tokens JWT.
# OBLIGATORIA: Los servicios se negarán a arrancar si falta o usa el valor por defecto.
# En producción (Render), genera una clave aleatoria segura de 64 caracteres:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=tu-clave-secreta-larga-y-aleatoria-de-64-caracteres

# Login institucional: con MODO_DEV=true el código se muestra en logs.
# En PRODUCCIÓN (Render), debe ser false o no definirse.
MODO_DEV=false

# SMTP para enviar el código (ej. Gmail con contraseña de aplicación).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cuenta@gmail.com
SMTP_PASSWORD=contraseña-de-aplicacion
SMTP_FROM=cuenta@gmail.com

# Código fijo de 6 dígitos solo para desarrollo con organizaciones de prueba (es_prueba = true).
# En PRODUCCIÓN (Render), NO definir esta variable.
# CODIGO_PRUEBA=123456
