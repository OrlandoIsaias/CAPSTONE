DATABASE_URL=postgresql://usuario:password@host/nombre_bd?sslmode=require

JWT_SECRET=cambia-esta-clave-en-produccion

# Login institucional: con MODO_DEV=true el código se muestra en los logs
# (docker compose logs auth-service) y no se envía correo.
MODO_DEV=true

# SMTP para enviar el código (ej. Gmail con contraseña de aplicación).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cuenta@gmail.com
SMTP_PASSWORD=contraseña-de-aplicacion
SMTP_FROM=cuenta@gmail.com

# Código fijo de 6 dígitos para organizaciones con es_prueba = true (no envía correo).
# Sin esta variable, la organización de prueba recibe el código por correo como las demás.
CODIGO_PRUEBA=123456
