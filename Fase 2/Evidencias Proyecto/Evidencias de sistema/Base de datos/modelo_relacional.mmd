erDiagram
    usuarios {
        int id PK
        varchar nombre
        varchar email UK
        varchar password_hash "opcional"
        varchar rol
        timestamp fecha_registro
        varchar estado
    }
    codigos_verificacion {
        int id PK
        int usuario_id FK
        varchar codigo_hash
        timestamp expira_en
        int intentos
        boolean usado
        timestamp creado_en
    }
    perfiles_adoptante {
        int id PK
        int usuario_id FK, UK
        varchar espacio_disponible "opcional"
        varchar experiencia_previa "opcional"
        varchar telefono "opcional"
        varchar foto_perfil "opcional"
        varchar especie_preferida FK
        varchar restriccion_vivienda "opcional"
        varchar horas_sola "opcional"
        varchar tiempo_actividad "opcional"
        varchar ambiente_hogar "opcional"
        varchar ninos_hogar "opcional"
        boolean tiene_perros
        boolean tiene_gatos
        varchar alergias "opcional"
        varchar acepta_cuidados "opcional"
        varchar sexo_preferido "opcional"
    }
    perfil_tamano_preferido {
        int perfil_id PK, FK
        varchar tamano PK, FK
    }
    perfil_etapa_preferida {
        int perfil_id PK, FK
        varchar etapa PK, FK
    }
    refugios {
        int id PK
        int usuario_id FK, UK
        varchar nombre_refugio
        varchar direccion "opcional"
        varchar telefono_contacto "opcional"
        int organizacion_id FK, UK
    }
    organizaciones_validadas {
        int id PK
        int rut UK
        char dv
        varchar razon_social
        text actividad "opcional"
        varchar direccion "opcional"
        date fecha_inscripcion "opcional"
        varchar correo "opcional"
        boolean es_prueba
        timestamp fecha_carga
        timestamp fecha_actualizacion
        int comuna_id FK
    }
    comunas {
        int id PK
        varchar nombre "unico con region_id"
        int region_id FK "unico con nombre"
    }
    regiones {
        int id PK
        varchar nombre UK
    }
    mascotas {
        int id PK
        int refugio_id FK
        varchar nombre
        varchar especie FK
        varchar raza FK
        int edad
        varchar nivel_energia
        varchar nivel_experiencia_requerida
        varchar espacio_minimo_requerido
        varchar estado
        timestamp fecha_publicacion
        text cuidados_especiales "opcional"
        varchar clave_seed UK
        varchar sexo
        varchar tamano FK
        varchar tolerancia_soledad
        varchar temperamento
        varchar convivencia_ninos "opcional"
        boolean convive_perros "opcional"
        boolean convive_gatos "opcional"
        varchar nivel_cuidados
        boolean esterilizado "opcional"
        boolean vacunas_al_dia "opcional"
        boolean desparasitado "opcional"
        boolean microchip "opcional"
        text notas_salud "opcional"
    }
    fotos_mascota {
        int id PK
        int mascota_id FK
        varchar url
        boolean es_principal
        int orden "opcional"
    }
    especies {
        varchar codigo PK
        varchar nombre
    }
    razas {
        varchar especie PK, FK
        varchar nombre PK
    }
    tamanos {
        varchar codigo PK
        varchar nombre
    }
    etapas_vida {
        varchar codigo PK
        varchar nombre
    }
    matches {
        int id PK
        int adoptante_id FK "unico con mascota_id"
        int mascota_id FK "unico con adoptante_id"
        numeric score_compatibilidad "opcional"
        timestamp fecha_calculo
        jsonb desglose "opcional"
    }
    postulaciones {
        int id PK
        int adoptante_id FK
        int mascota_id FK
        varchar estado
        timestamp fecha_postulacion
        timestamp fecha_adopcion "opcional"
        numeric score_al_postular "opcional"
        jsonb desglose_al_postular "opcional"
    }
    seguimientos_post_adopcion {
        int id PK
        int postulacion_id FK "unico con dias_transcurridos"
        int dias_transcurridos "unico con postulacion_id"
        varchar resultado
        text motivo_devolucion "opcional"
        timestamp fecha_respuesta
    }
    mensajes_seguimiento {
        int id PK
        int postulacion_id FK
        int autor_usuario_id FK
        varchar tipo
        text texto "opcional"
        varchar media_public_id "opcional"
        numeric duracion_seg "opcional"
        timestamp creado_en
        timestamp leido_en "opcional"
    }

    usuarios ||--o{ codigos_verificacion : "verifica"
    especies |o--o{ perfiles_adoptante : "especie preferida"
    usuarios ||--o| perfiles_adoptante : "perfil de"
    perfiles_adoptante ||--o{ perfil_tamano_preferido : "prefiere"
    tamanos ||--o{ perfil_tamano_preferido : "tamano"
    etapas_vida ||--o{ perfil_etapa_preferida : "etapa"
    perfiles_adoptante ||--o{ perfil_etapa_preferida : "prefiere"
    organizaciones_validadas ||--o| refugios : "valida"
    usuarios ||--o| refugios : "cuenta de"
    comunas |o--o{ organizaciones_validadas : "ubicada en"
    regiones ||--o{ comunas : "pertenece a"
    especies ||--o{ mascotas : "es de"
    razas |o--o{ mascotas : "es de raza"
    refugios ||--o{ mascotas : "publica"
    tamanos |o--o{ mascotas : "tamano"
    mascotas ||--o{ fotos_mascota : "foto de"
    especies ||--o{ razas : "de la especie"
    mascotas ||--o{ matches : "compara con"
    perfiles_adoptante ||--o{ matches : "calcula para"
    mascotas ||--o{ postulaciones : "a la mascota"
    perfiles_adoptante ||--o{ postulaciones : "postula"
    postulaciones ||--o{ seguimientos_post_adopcion : "sigue"
    postulaciones ||--o{ mensajes_seguimiento : "chat de"
    usuarios ||--o{ mensajes_seguimiento : "escrito por"
